# ============================================================
# Abdullah Portfolio V2 — Environment variables
# Copy to .env (never commit .env) and fill in.
# On Vercel: add the same variables in Project Settings → Environment Variables.
# ============================================================

# ---- Supabase (Project Settings → API) ----
# Public — safe to expose in the browser (protected by RLS)
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret — serverless functions ONLY. Never expose to the client bundle.
SUPABASE_SECRET_KEY=sb_secret_...

# Serverless-only: contact form notification target (optional)
CONTACT_NOTIFY_EMAIL=abdallhalghoul200@gmail.com

# ---------- Public site (api/*, Vercel serverless) ----------
# Same values as above; the public site's serverless functions read these.

# ---------- Admin dashboard (admin/.env.local) ----------
# Public — safe to expose to the dashboard client
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---------- Optional: existing AI assistant (api/chat.js) ----------
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
